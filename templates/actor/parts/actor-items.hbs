<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>Iconic Items</span>
    <hr />
    <div class="item-controls">
      <a
        class="item-control item-create"
        title="{{localize 'DOCUMENT.Create' type="Item"}}"
        data-type="iconicItem"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
  {{#each iconicItems as |item id|}}
    <li class="flexrow item mm-item mm-actor-iconic-item" data-item-id='{{item._id}}'>
      <div class="item-name mm-item-name">
        <a>
          <span>{{item.name}}</span>
          {{#if item.system.powers.length}}
            <span class="mm-item-subtext">Powers: {{#each item.system.powers}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}</span>
          {{/if}}
          {{#each item.weaponAttacks as |attack|}}
            <span class="mm-item-subtext mm-iconic-attack-info" data-weapon-mode="{{attack.mode}}">{{localize (concat "MARVEL_MULTIVERSE.Iconic.Attack." attack.mode)}}{{#if attack.range}} {{attack.range}}{{/if}}{{#if attack.bonus}}, {{localize "MARVEL_MULTIVERSE.Weapon.Multiplier"}} +{{attack.bonus}}{{/if}}</span>
          {{/each}}
        </a>
      </div>
      {{#if item.weaponAttacks.length}}
        <div class="mm-item-detail">
          {{#each item.weaponAttacks as |attack|}}
            <a class="item-control rollable mm-iconic-attack" data-weapon-mode="{{attack.mode}}"
              data-formula="{1d6,1dm,1d6}+@abilities.{{attack.ability}}.value" data-label="{{attack.ability}}" data-ability-key="{{attack.ability}}" data-damagetype="health"
              title="{{localize (concat 'MARVEL_MULTIVERSE.Iconic.Roll.' attack.mode)}}">
              <i class="fas {{#if (eq attack.mode 'melee')}}fa-hand-fist{{else}}fa-bullseye{{/if}}"></i>
            </a>
          {{/each}}
        </div>
      {{/if}}
      <div class="mm-item-detail">
        <span class="mm-pv-badge" title="Power Value">PV {{item.powerValue}}</span>
      </div>
      <div class="mm-item-detail">
        <select class="iconic-ownership-toggle" data-item-id="{{item._id}}">
          <option value="owned" {{#if (eq item.system.ownershipMode "owned")}}selected{{/if}}>Owned</option>
          <option value="borrowed" {{#if (eq item.system.ownershipMode "borrowed")}}selected{{/if}}>Borrowed</option>
        </select>
      </div>
      <div class="item-controls">
        <a
          class="item-control item-edit"
          title="{{localize 'DOCUMENT.Update' type="Item"}}"
        >
          <i class="fas fa-edit"></i>
        </a>
        <a
          class="item-control item-delete"
          title="{{localize 'DOCUMENT.Delete' type="Item"}}"
        >
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>Battle Suits</span>
    <hr />
    <div class="item-controls">
      <a
        class="item-control item-create"
        title="{{localize 'DOCUMENT.Create' type="Item"}}"
        data-type="battleSuit"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
  {{#each battleSuits as |item id|}}
    <li class="flexrow item mm-item mm-actor-battlesuit {{#if item.system.equipped}}mm-equipped{{/if}}" data-item-id='{{item._id}}'>
      <div class="item-name mm-item-name">
        <a>
          <span>{{item.name}}</span>
          {{#if item.modifiersSummary}}
            <span class="mm-item-subtext">{{item.modifiersSummary}}</span>
          {{/if}}
        </a>
      </div>
      <div class="mm-item-detail">
        <span class="mm-pv-badge" title="Power Value">PV {{item.powerValue}}</span>
      </div>
      <div class="mm-item-detail">
        <a class="item-control battlesuit-equip-toggle" data-item-id="{{item._id}}" title="{{#if item.system.equipped}}Unequip{{else}}Equip{{/if}}">
          <i class="fas {{#if item.system.equipped}}fa-toggle-on mm-equipped-icon{{else}}fa-toggle-off{{/if}}"></i>
        </a>
      </div>
      <div class="item-controls">
        <a
          class="item-control item-edit"
          title="{{localize 'DOCUMENT.Update' type="Item"}}"
        >
          <i class="fas fa-edit"></i>
        </a>
        <a
          class="item-control item-delete"
          title="{{localize 'DOCUMENT.Delete' type="Item"}}"
        >
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>{{localize "Items"}}</span>
    <hr />
    <div class="item-controls">
      <a
        class="item-control item-create"
        title="{{localize 'DOCUMENT.Create' type="Item"}}"
        data-type="item"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
  {{#each gear as |item id|}}
    <li class="flexrow item mm-item" data-item-id='{{item._id}}'>
      <div class="item-name mm-item-name">
        <span>{{item.name}}</span>
      </div>
      <div class="item-controls">
        <a
          class="item-control item-edit"
          title="{{localize 'DOCUMENT.Update' type="Item"}}"
        >
          <i class="fas fa-edit"></i>
        </a>
        <a
          class="item-control item-delete"
          title="{{localize 'DOCUMENT.Delete' type="Item"}}"
        >
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
