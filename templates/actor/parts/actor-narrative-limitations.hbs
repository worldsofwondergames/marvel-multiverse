{{!-- Shown once the actor has a limitation. The first one is added by dropping it on the sheet. --}}
{{#if narrativeLimitations.length}}
<ol class="mm-item-list mm-narrative-limitations">
  <li class="flexrow item mm-item-header">
    <span>{{localize 'MARVEL_MULTIVERSE.NarrativeLimitations'}}</span>
    <hr />
    <div class="item-controls">
      <a
        class="item-control item-create"
        title="{{localize 'DOCUMENT.Create' type=(localize 'TYPES.Item.narrativeLimitation')}}"
        data-type="narrativeLimitation"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
  {{#each narrativeLimitations as |item id|}}
    <li class="flexrow item mm-item" data-item-id="{{item._id}}">
      <div class="item-name mm-item-name">
        <a class="item-expand" title="{{localize 'MARVEL_MULTIVERSE.Item.ShowDetails'}}"><i class="fas fa-caret-right mm-expand-caret"></i><span>{{item.name}}</span></a>
      </div>
      <div class="item-controls">
        <a
          class="item-control item-chat rollable"
          title="{{localize 'MARVEL_MULTIVERSE.Item.SendToChat'}}"
          data-roll-type="item"
        >
          <i class="fas fa-comment"></i>
        </a>
        <a
          class="item-control item-edit"
          title="{{localize 'DOCUMENT.Edit' type=(localize 'TYPES.Item.narrativeLimitation')}}"
        >
          <i class="fas fa-edit"></i>
        </a>
        <a
          class="item-control item-delete"
          title="{{localize 'DOCUMENT.Delete' type=(localize 'TYPES.Item.narrativeLimitation')}}"
        >
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
{{/if}}
