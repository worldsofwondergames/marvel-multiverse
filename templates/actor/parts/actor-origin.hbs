{{#each origins as |item id|}}
  <div class="item mm-input-item" data-item-id="{{item._id}}">
    <h4>
      <a class="item-expand" title="{{localize 'MARVEL_MULTIVERSE.Item.ShowDetails'}}"><i class="fas fa-caret-right mm-expand-caret"></i><span>{{item.name}}</span></a>
      <a class="item-control item-chat rollable" data-roll-type="item" title="{{localize 'MARVEL_MULTIVERSE.Item.SendToChat'}}">
        <i class="fas fa-comment"></i>
      </a>
      <a class="item-control item-delete" title="{{localize 'DOCUMENT.Delete' type='origin'}}">
        <i class="fas fa-trash"></i>
      </a>
    </h4>
  </div>
{{/each}}
