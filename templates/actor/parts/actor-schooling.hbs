{{!-- Schooling Advancement Chart: ten boxes, left column 0-4, right column 5-9. --}}
<div class="mm-styled-container mm-schooling-block">
  <h3>{{localize "MARVEL_MULTIVERSE.Schooling.Title"}}</h3>
  <div class="mm-styled-container-body">
    <div class="mm-schooling-grid">
      {{#each schoolingBoxes}}
      <label class="mm-schooling-box" data-box-index="{{this.index}}">
        <input type="checkbox" name="{{this.name}}" {{checked this.checked}} {{#unless @root.editable}}disabled{{/unless}}/>
        <span class="mm-schooling-reward">{{this.label}}</span>
      </label>
      {{/each}}
    </div>
    <div class="mm-schooling-footer">
      <span class="mm-schooling-progress">{{schoolingCompleted}} / 10</span>
      {{#if schoolingReadyToAdvance}}
      <span class="mm-schooling-ready">{{localize "MARVEL_MULTIVERSE.Schooling.ReadyToAdvance"}}</span>
      {{/if}}
    </div>
  </div>
</div>
