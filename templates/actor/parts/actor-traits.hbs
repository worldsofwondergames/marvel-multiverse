<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>Traits</span>
    <hr />
    <div class="item-controls">
      <a
        class="item-control item-create"
        title="Create item"
        data-type="trait"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
  {{#each traits as |item id|}}
    <li class="flexrow item mm-item" data-item-id='{{item._id}}'>
      <div class="item-name mm-item-name">
        <a class="item-expand" title="{{localize 'MARVEL_MULTIVERSE.Item.ShowDetails'}}"><i class="fas fa-caret-right mm-expand-caret"></i><span>{{item.name}}{{#if item.system.detail}}: <span style="text-transform:none;">{{item.system.detail}}</span>{{/if}}</span></a>
      </div>
      <div class="item-controls">
        <a
          class="item-control item-chat rollable"
          title="{{localize 'MARVEL_MULTIVERSE.Item.SendToChat'}}"
          data-roll-type="item"
        >
          <i class="fas fa-comment"></i>
        </a>
        <a
          class="item-control item-edit"
          title="{{localize 'DOCUMENT.Edit' type="trait"}}"
        >
          <i class="fas fa-edit"></i>
        </a>
        <a
          class="item-control item-delete"
          title="{{localize 'DOCUMENT.Delete' type="trait"}}"
        >
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
