<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>Weapons</span>
    <hr />
    <div class="item-controls">
      <a
        class="item-control item-create"
        title="Create item"
        data-type="weapon"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
  {{#each weapons as |item id|}}
    <li class="flexrow item mm-item" data-item-id='{{item._id}}' data-damagetype='{{item.system.damageType}}'>
      <div class="item-name mm-item-name">
        <a class="item-expand" title="{{localize 'MARVEL_MULTIVERSE.Item.ShowDetails'}}"><i class="fas fa-caret-right mm-expand-caret"></i><span>{{item.name}}{{#if item.weaponBonus}}: <span class="mm-weapon-bonus" style="text-transform:none;">{{localize "MARVEL_MULTIVERSE.Weapon.Multiplier"}} +{{item.weaponBonus}}</span>{{/if}}</span></a>
      </div>
      <div class="item-controls">
        <a
          class="item-control item-chat rollable"
          title="{{localize 'MARVEL_MULTIVERSE.Item.SendToChat'}}"
          data-roll-type="item" data-damagetype="{{item.system.damageType}}"
        >
          <i class="fas fa-comment"></i>
        </a>
        <a
          class="item-control item-edit"
          title="{{localize 'DOCUMENT.Edit' type="weapon"}}"
        >
          <i class="fas fa-edit"></i>
        </a>
        <a
          class="item-control item-delete"
          title="{{localize 'DOCUMENT.Delete' type="weapon"}}"
        >
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
